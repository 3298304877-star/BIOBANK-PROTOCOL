missing_rate <- colMeans(is.na(df[,-1]))   
keep_cols <- missing_rate < 0.3            
df_clean <- df[, c(TRUE, keep_cols)]            
df_clean <- df_clean %>%
mutate(across(where(is.numeric), 
 ~ ifelse(is.na(.), )))
df_clean <- df_clean %>%
mutate(across(.cols = -eid,.fns = ~ log2(. + 1)))
df_final <- df_clean %>% mutate(across(.cols = -eid, ~ scale(.) %>% as.numeric()))
